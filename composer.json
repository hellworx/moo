{
    "name": "hellworx/moo",
    "description": "Moo is a small, dependency free PHP front controller",
    "type": "library",
    "homepage": "https://github.com/hellworx/moo",
    "license": "MIT",
    "authors": [
        {
            "name": "Lukasz Cepowski",
            "email": "lukasz@cepowski.com",
            "homepage": "https://cepowski.com"
        }
    ],
    "support": {
        "email": "lukasz@cepowski.com",
        "source": "https://github.com/hellworx/moo",
        "issues": "https://github.com/hellworx/moo/issues"
    },
    "require": {
        "php": ">=8.0 <9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "Moo\\": "src/Moo"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Moo\\": "test/Tests/Moo"
        }
    }
}
